class_name TdLevelPreview
extends Control
## Level select's picture of the selected level (mockup screens-b/level-select.html ".map"): the shared board
## thumbnail renderer CoopBoardPic (UI/UX rule 2026-10-14, the same framing as the co-op cards: a 35° camera,
## "contain" so the whole board shows, never cropped, and the margin left over filled with a darkened, blurred copy
## of the render). The picture is the level's pre-rendered PNG (LevelPreviewCache: res://art/levels/previews,
## regenerated by tools/level_previews.gd), shown at once; only a level without a fresh PNG renders live (logged),
## showing nothing until its first frame is drawn (no minimap-to-board flicker). Cached per level and size in
## CoopBoardPic.cache. cancel() drops a pending live render (level select calls it when it closes).
## This file also keeps the board scene and camera fit helpers CoopBoardPic.render uses (_model, _fit).
##   var p := TdLevelPreview.new(); p.custom_minimum_size = Vector2(580, 300); add_child(p); p.show_level(level)

## Camera pitch (degrees below the horizon) and turn, as the co-op cards.
const PITCH := 35.0
const YAW := -8.0

var level: LevelAsset = null
var _pic: CoopBoardPic

func _init() -> void:
	mouse_filter = MOUSE_FILTER_IGNORE
	clip_contents = true

func _ready() -> void:
	_pic = CoopBoardPic.new()
	_pic.pitch = PITCH
	_pic.yaw = YAW
	_pic.placeholder_minimap = false
	_pic.custom_minimum_size = custom_minimum_size if custom_minimum_size.x > 4.0 else size
	add_child(_pic)
	_pic.set_anchors_and_offsets_preset(PRESET_FULL_RECT)
	if level != null: _pic.show_level(level.get_id())

## Shows a level: its cached board at once, else the minimap while the board renders.
func show_level(lv: LevelAsset) -> void:
	level = lv
	if _pic == null: return
	_pic.visible = lv != null
	if lv != null: _pic.show_level(lv.get_id())

## Drops a pending live render (the screen is closing: nothing renders or appears after it is gone).
func cancel() -> void:
	if _pic != null: _pic.cancel()

## Desaturates the picture (a locked mission).
func set_grey(v: bool) -> void:
	if _pic != null: _pic.grey = v

## Whether the board of the shown level is up (not the minimap).
func is_board_shown() -> bool:
	return _pic != null and _pic.is_board_shown()

static func _model(root: Node3D, app: Node, view: String, tile: Vector2i) -> void:
	var sc: PackedScene = app.model_scene(view)
	if sc == null: return
	var m: Node3D = sc.instantiate()
	m.position = GridSpace.to_world(tile)
	root.add_child(m)
	for n in m.find_children("*", "MeshInstance3D", true, false):
		if String(n.name).to_lower() == "hitbox": n.visible = false

## Places the camera so the whole board (with its frame and the trees along its back edge) fits the picture with a
## small margin ("contain": ~90 % of the limiting side): three passes of
## "measure the corners on screen, scale the distance", then the offsets centre it.
static func _fit(cam: Camera3D, px: Vector2, grid: Vector2i, p_pitch: float, p_yaw: float) -> void:
	var c := Vector3((grid.x - 1) / 2.0, 0.0, -(grid.y - 1) / 2.0)
	var corners := []
	for x in [-0.8, grid.x - 0.2]:
		for z in [0.8, 0.2 - float(grid.y)]:
			for y in [-0.25, 0.8]: corners.append(Vector3(x, y, z))
	var dir := Vector3(0, sin(deg_to_rad(p_pitch)), cos(deg_to_rad(p_pitch))).rotated(Vector3.UP, deg_to_rad(p_yaw))
	var dist := float(maxi(grid.x, grid.y)) * 2.2
	var half_tan := tan(deg_to_rad(cam.fov) * 0.5)
	for pass_i in 4:
		cam.h_offset = 0.0
		cam.v_offset = 0.0
		cam.position = c + dir * dist
		cam.look_at(c, Vector3.UP)
		# corners in camera space → normalised screen units (-1..1 on the height)
		var inv := cam.global_transform.affine_inverse()
		var lo := Vector2(INF, INF)
		var hi := Vector2(-INF, -INF)
		for w in corners:
			var l: Vector3 = inv * w
			var d := maxf(-l.z, 0.01)
			var s := Vector2(l.x / d, l.y / d) / half_tan
			lo = Vector2(minf(lo.x, s.x), minf(lo.y, s.y))
			hi = Vector2(maxf(hi.x, s.x), maxf(hi.y, s.y))
		var aspect := px.x / maxf(px.y, 1.0)
		var need := maxf((hi.x - lo.x) / (2.0 * aspect), (hi.y - lo.y) / 2.0) / 0.92
		if pass_i < 3:
			dist *= need
		else:
			var mid := (lo + hi) * 0.5 # screen units; offsets are world units at the look distance
			cam.h_offset = mid.x * half_tan * dist
			cam.v_offset = mid.y * half_tan * dist
